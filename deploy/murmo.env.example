# /etc/murmo/murmo.env, read by murmo.service. Every setting is in docs/HOSTING.md, "Configuration".

# The public address, behind your TLS proxy (Caddy, nginx, …). It goes into users' signed identity logs: choose it once.
MURMO_ORIGIN=https://chat.example.org

# Where the server listens; the proxy on this machine passes requests here.
MURMO_BIND=127.0.0.1:8080

# Believe X-Forwarded-For from the proxy on this machine.
MURMO_TRUST_PROXY=1

# MURMO_FEDERATION=open
# MURMO_FEDERATION_BLOCK=
# MURMO_GIPHY_KEY=
