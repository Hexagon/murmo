# Copy to .env and set your domain. Its DNS must point at this machine, and ports 80 and 443 must reach it: Caddy gets
# the certificate for it on first start.
MURMO_DOMAIN=chat.example.org

# The image to run. 0.2 gets every 0.2.x patch with `docker compose pull`; a new minor version waits until you change
# this, after reading its notes in the release.
MURMO_IMAGE=ghcr.io/hexagon/murmo:0.3

# Where the database and host key are: a named volume (the default), or a directory on this machine, owned by uid
# 65532 (the user the server runs as). See "Moving to the container" in docs/HOSTING.md.
# MURMO_DATA=/srv/murmo

# Anything else from docs/HOSTING.md "Configuration" can go here too. Not MURMO_ORIGIN (made from MURMO_DOMAIN), and
# not MURMO_DB, MURMO_HOST_KEY_FILE, MURMO_BIND or MURMO_CLIENT_DIR: the image sets those to its own paths. For example:
# MURMO_FEDERATION=open
# MURMO_FEDERATION_BLOCK=
# MURMO_GIPHY_KEY=
# MURMO_PUSH_CONTACT=mailto:you@example.org
